{
  "manifest_version": 3,
  "name": "Cogwheel SEO — Universal Autonomous SEO & GEO Engine",
  "version": "2.0.0",
  "description": "Autonomous SEO, GEO & Self-Healing CMS Auditing Engine with preserved Hospitality & Universal Modes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Cogwheel SEO Dashboard"
  },
  "side_panel": {
    "default_path": "src/ui/dashboard.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
