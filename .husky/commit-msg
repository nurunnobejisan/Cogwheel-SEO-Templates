#!/bin/sh
# ==============================================================================
# COGWHEEL SEO STUDIO — COMMIT-MSG HOOK
# Enforces Conventional Commits specification: <type>(<scope>): <subject>
# Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
# ==============================================================================

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge commits or squash commits automatically
if echo "$COMMIT_MSG" | grep -qE "^Merge "; then
  exit 0
fi

# Conventional commit regex
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_-]+\))?: .{1,100}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo "❌ INVALID COMMIT MESSAGE FORMAT!"
  echo ""
  echo "Your message was:"
  echo "  $COMMIT_MSG"
  echo ""
  echo "Commit messages must follow the Conventional Commits specification:"
  echo "  <type>(<scope>): <subject>"
  echo ""
  echo "Examples:"
  echo "  feat(schemas): add hotel-seo schema and strict Pydantic v2 model"
  echo "  fix(extension): resolve DOM image alt detection on dynamic pages"
  echo "  docs(readme): update CI suite and architecture diagram"
  echo "  test(hotel-seo): add boundary check test cases for entityDensityScore"
  echo ""
  echo "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi

exit 0
