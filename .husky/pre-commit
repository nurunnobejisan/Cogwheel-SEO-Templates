#!/bin/sh
. "$(dirname "$0")/_/husky.sh" 2>/dev/null || true

echo "🔍 Running pre-commit security and integrity checks..."

# 1. Secret Scanning
echo "1/4 Secret scan..."
if grep -rnE "(ghp_[a-zA-Z0-9]{20,}|sk-[a-zA-Z0-9]{20,}|AIza[0-9A-Za-z-_]{35})" src/ validators/ schemas/ exporters/ api/ 2>/dev/null; then
  echo "❌ COMMIT BLOCKED: Secret or private credential detected!"
  exit 1
fi

# 2. TypeScript Layer Verification (Vitest / Test Runner)
echo "2/4 Running TypeScript test suite..."
node --test --experimental-strip-types tests/ts/*.test.ts
if [ $? -ne 0 ]; then
  echo "❌ COMMIT BLOCKED: TypeScript tests failed."
  exit 1
fi

# 3. Python Layer Verification
echo "3/4 Running Python layer tests..."
python3 tests/python/run_tests.py 2>/dev/null || true

# 4. Master 10-Gate SEO Linter
echo "4/4 Running 10-Gate SEO Integrity Linter..."
node --experimental-strip-types tests/seoLinter.ts
if [ $? -ne 0 ]; then
  echo "❌ COMMIT BLOCKED: SEO Integrity Linter failed."
  exit 1
fi

echo "✅ All pre-commit quality checks passed."
exit 0
