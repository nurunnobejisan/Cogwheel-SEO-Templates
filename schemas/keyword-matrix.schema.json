{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KeywordStrategyMatrix",
  "description": "Standard JSON Schema for an SEO Studio vertical-pack keyword strategy matrix (78 keywords across 6 declared categories).",
  "$ref": "#/definitions/KeywordStrategyMatrix",
  "definitions": {
    "KeywordStrategyMatrix": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "datasetName": {
              "type": "string"
            },
            "totalKeywords": {
              "type": "integer",
              "minimum": 1
            },
            "lastUpdated": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "targetIndustries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "categorySummary": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "notes": {
              "type": "string",
              "description": "Provenance note stating which fields are planning aids rather than measurements."
            }
          },
          "required": [
            "version",
            "datasetName",
            "totalKeywords",
            "lastUpdated",
            "author",
            "targetIndustries",
            "categorySummary"
          ],
          "additionalProperties": false
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "keyword": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "description": "Pack-defined category; must appear in the matrix's declared categories list."
              },
              "subCategory": {
                "type": "string"
              },
              "searchIntent": {
                "type": "string",
                "enum": [
                  "Navigational",
                  "Informational",
                  "Commercial",
                  "Transactional",
                  "Conversational/Generative"
                ]
              },
              "searchVolumeTier": {
                "type": "string",
                "enum": [
                  "High",
                  "Medium",
                  "Low",
                  "Long-Tail / Conversational"
                ]
              },
              "cpcEstimate": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "illustrative"
                    ],
                    "description": "Only 'illustrative' is accepted: no measured CPC data exists for these datasets."
                  }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              },
              "targetPageType": {
                "type": "string"
              },
              "recommendedSchema": {
                "type": "string"
              },
              "geoEngineRelevance": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "targetEntityPrompt": {
                "type": "string"
              },
              "competitiveContext": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "keyword",
              "category",
              "subCategory",
              "searchIntent",
              "searchVolumeTier",
              "cpcEstimate",
              "targetPageType",
              "recommendedSchema",
              "geoEngineRelevance",
              "targetEntityPrompt",
              "competitiveContext"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "metadata",
        "categories",
        "keywords"
      ],
      "additionalProperties": false
    }
  }
}