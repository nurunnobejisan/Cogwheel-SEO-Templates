{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomShowcase",
  "type": "object",
  "required": [
    "hotelName",
    "cityName",
    "roomTitle",
    "roomDescription"
  ],
  "properties": {
    "hotelName": {
      "type": "string",
      "minLength": 1
    },
    "cityName": {
      "type": "string",
      "minLength": 1
    },
    "roomTitle": {
      "type": "string",
      "minLength": 3
    },
    "roomStartingRate": {
      "type": "string",
      "default": "Best Available Rate"
    },
    "roomDescription": {
      "type": "string",
      "minLength": 20
    },
    "roomAmenities": {
      "type": "string",
      "default": "King pillow-top bed, high-speed WiFi, smart television, and luxury bath amenities"
    }
  }
}
