{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MlGoldenCase",
  "description": "Hand-checked golden evaluation case: an MlExample with the section-9 checks to apply and an operator note.",
  "$ref": "#/definitions/MlGoldenCase",
  "definitions": {
    "MlGoldenCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task": {
          "type": "string",
          "enum": [
            "schema_generation",
            "metadata_generation",
            "rag_synthesis",
            "page_classification",
            "entity_gap_analysis"
          ]
        },
        "input": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "domainHash": {
              "type": "string",
              "minLength": 1
            },
            "pageType": {
              "type": "string",
              "enum": [
                "hotel_homepage",
                "room_details",
                "amenities",
                "booking",
                "location",
                "article",
                "landing_page",
                "other",
                "dining",
                "spa",
                "offers",
                "meetings_events",
                "faq",
                "gallery",
                "contact"
              ]
            },
            "text": {
              "type": "string"
            },
            "measured": {
              "type": "object",
              "additionalProperties": {}
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issueId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "metadata",
                      "content",
                      "media",
                      "technical",
                      "accessibility",
                      "schema",
                      "hospitality"
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "info"
                    ]
                  },
                  "fixable": {
                    "type": "boolean"
                  },
                  "cmsTargetField": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "context": {
                    "type": "object",
                    "properties": {
                      "currentValue": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      },
                      "selector": {
                        "type": "string"
                      },
                      "imageSrc": {
                        "type": "string"
                      },
                      "recommendedAction": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "currentValue",
                      "selector",
                      "recommendedAction"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "issueId",
                  "category",
                  "severity",
                  "fixable",
                  "cmsTargetField",
                  "context"
                ],
                "additionalProperties": false
              }
            },
            "retrieved": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passage": {
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "passage"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "domainHash",
            "measured"
          ],
          "additionalProperties": false
        },
        "output": {},
        "provenance": {
          "type": "string",
          "enum": [
            "measured",
            "estimated",
            "unavailable"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "consent": {
          "type": "boolean",
          "const": true
        },
        "split": {
          "type": "string",
          "const": "eval"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "jsonld_valid",
              "grounding",
              "invented_metrics",
              "title_budget",
              "classifier_macro_f1",
              "explainer_citation",
              "human_review"
            ]
          },
          "minItems": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "task",
        "input",
        "provenance",
        "source",
        "licence",
        "synthetic",
        "split",
        "createdAt",
        "checks",
        "note"
      ],
      "additionalProperties": false
    }
  }
}