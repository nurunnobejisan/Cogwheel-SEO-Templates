{
  "name": "seo-studio-seo-studio",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:seo": "tsx tests/ts/seoLinter.ts",
    "test:seo": "tsx tests/ts/seoLinter.ts && node --import tsx --test tests/schemas.test.ts tests/internalLinker.test.ts tests/securityGuardrails.test.ts tests/variableResolver.test.ts tests/exporters.test.ts tests/uniquenessGate.test.ts tests/serpOptimizer.test.ts tests/heading-structure-audit.test.ts tests/image-optimization-audit.test.ts tests/unified-seo-platform.test.ts tests/hotel-seo.test.ts",
    "preview:seo": "tsx scripts/seo-preview-cli.ts",
    "test:ts": "node --import tsx --test tests/ts/*.test.ts",
    "export:schemas": "tsx scripts/export-schemas.ts",
    "export:json-schemas": "tsx scripts/export-json-schemas.ts",
    "build:extension": "node scripts/build-extension.js",
    "extension:build": "cd chrome-extension && npm run build",
    "extension:pack": "cd chrome-extension && npm run build && cd dist && rm -f ../../public/cogwheel-seo-studio.zip && zip -r ../../public/cogwheel-seo-studio.zip . -x '*.DS_Store'",
    "brain:eval": "tsx --conditions=react-server scripts/brain-eval.ts",
    "brain:export-lora": "tsx scripts/export-lora-dataset.ts",
    "train:validate": "node scripts/validate-training-data.mjs && tsx scripts/validate-ml-examples.ts && tsx scripts/check-golden-set.ts && tsx scripts/export-ml-sources.ts --check && python3 ml/dataset/cards.py --check",
    "ml:golden:check": "tsx scripts/check-golden-set.ts",
    "ml:sources:export": "tsx scripts/export-ml-sources.ts",
    "ml:cards": "python3 ml/dataset/cards.py",
    "ml:cards:check": "python3 ml/dataset/cards.py --check",
    "train:clean": "python3 scripts/clean-training-data.py",
    "geo:drift": "tsx scripts/geo-drift.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.109.0",
    "@vercel/speed-insights": "^2.1.0",
    "googleapis": "^178.0.0",
    "next": "^14.2.25",
    "papaparse": "^5.4.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.25",
    "husky": "^9.0.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "postcss": "^8.4.39",
    "schema-dts": "^1.1.2",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vitest": "^2.0.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
