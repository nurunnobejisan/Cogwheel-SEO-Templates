{
  "name": "cogwheel-seo-studio",
  "version": "2.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:seo": "node --experimental-strip-types tests/seoLinter.ts",
    "test:seo": "node --experimental-strip-types tests/seoLinter.ts && node --test --experimental-strip-types tests/*.test.ts",
    "preview:seo": "node --experimental-strip-types scripts/seo-preview-cli.ts",
    "test:ts": "node --test --experimental-strip-types tests/ts/*.test.ts",
    "export:schemas": "node --experimental-strip-types scripts/export-schemas.ts",
    "export:json-schemas": "node --experimental-strip-types scripts/export-json-schemas.ts",
    "extension:build": "cd chrome-extension && npm run build",
    "extension:pack": "cd chrome-extension && npm run build && cd dist && zip -r ../../public/cogwheel-chrome-extension.zip . -x '*.DS_Store'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.109.0",
    "@vercel/speed-insights": "^2.1.0",
    "googleapis": "^178.0.0",
    "next": "^14.2.25",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.25",
    "husky": "^9.0.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "postcss": "^8.4.39",
    "schema-dts": "^1.1.2",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^2.0.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
