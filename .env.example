# ==============================================================================
# SEO Studio Templates — Environment Configuration
# ==============================================================================

# Application Environment
# Options: development | staging | production
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Database & Backend Services (Supabase)
# ------------------------------------------------------------------------------
# Supabase URL & Service Role Key (server-side only — never expose service role key to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# AI & LLM Providers
# ------------------------------------------------------------------------------
# Free-first: with no key set, drafting uses a keyless free provider
# (Pollinations). Adding any FREE key below upgrades quality at no cost.
# A paid key (ANTHROPIC_API_KEY) is opt-in and never required.
#
# Provider order: Anthropic (if key) -> Gemini -> Groq -> OpenRouter -> Pollinations.
# Every model id is overridable; current defaults live in src/core/ai/models.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Free tier (also used by drafting):
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY is accepted as an alias for GEMINI_API_KEY.
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Keyless drafting fallback (set ENABLE_FREE_ONLINE_AI=0 to disable):
ENABLE_FREE_ONLINE_AI=1
POLLINATIONS_MODEL=openai
# Optional paid add-ons. Never required; the app works at $0 without them.
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=

# ------------------------------------------------------------------------------
# AI / GEO Visibility Measurement (free tier, server-side only)
# ------------------------------------------------------------------------------
# The visibility adapters are default-off. Opt in explicitly; all keys stay on
# the server. Zero-cost tiers only: Gemini grounded search, Groq Llama 3.3,
# OpenRouter :free models, and opt-in keyless Pollinations (model memory).
VISIBILITY_FREE_PROVIDERS_ENABLED=false
GEMINI_VISIBILITY_MODEL=gemini-2.5-flash
GROQ_VISIBILITY_MODEL=llama-3.3-70b-versatile
OPENROUTER_VISIBILITY_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
POLLINATIONS_ENABLED=false
# Estimated cost accounting for free tiers defaults to 0; overrides only tighten caps.
GEMINI_VISIBILITY_COST_USD=0
GROQ_VISIBILITY_COST_USD=0
OPENROUTER_VISIBILITY_COST_USD=0
# Per-provider rate limits and global daily caps (defaults shown).
VISIBILITY_RPM_DEFAULT=20
VISIBILITY_RPM_GEMINI_GROUNDED=20
VISIBILITY_RPM_GROQ_LLAMA=20
VISIBILITY_RPM_OPENROUTER_FREE=10
VISIBILITY_RPM_POLLINATIONS=10
VISIBILITY_DAILY_CALL_CAP=60
VISIBILITY_DAILY_COST_CAP_USD=3

# Optional paid add-ons for visibility measurement (never required):
# OPENAI_API_KEY, ANTHROPIC_API_KEY and PERPLEXITY_API_KEY above enable these.
# OPENAI_VISIBILITY_MODEL=gpt-4o-mini
# ANTHROPIC_VISIBILITY_MODEL=claude-sonnet-5-5
# PERPLEXITY_MODEL=sonar
# Set to false when a key cannot use the provider's web-search tool; the answer
# is then labelled as model memory rather than a grounded citation.
# OPENAI_WEB_SEARCH=true
# ANTHROPIC_WEB_SEARCH=true

# Assistant / Brain budget (free-first provider chain with a rules fallback):
# BRAIN_DAILY_CALL_CAP=60
# BRAIN_DAILY_COST_CAP_USD=3

# Storage locations. Data dir defaults to the OS temp directory; GEO snapshot
# history is enabled by default (set off/false/0 to disable).
# SEO_STUDIO_DATA_DIR=
# SEO_STUDIO_GEO_STORE=on

# ------------------------------------------------------------------------------
# Google Workspace & Cloud Drive Integration
# ------------------------------------------------------------------------------
# Service Account JSON credentials: either base64-encoded here (preferred) or
# the raw JSON in GOOGLE_SERVICE_ACCOUNT_JSON. Server-side only.
GOOGLE_SERVICE_ACCOUNT_B64=
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Phase 1 Task Google Drive Templates
GOOGLE_TEMPLATE_DOC_ID_A=
GOOGLE_TEMPLATE_DOC_ID_B=
GOOGLE_HILTON_TEMPLATE_DOC_ID=
GOOGLE_TEMPLATE_DOC_ID_TITLE_META=
GOOGLE_TEMPLATE_SHEET_ID_HEADINGS=

# Phase 2 & 3 Google Drive Templates
GOOGLE_TEMPLATE_BASELINE_DOC_ID=
GOOGLE_TEMPLATE_COMPSET_KW_SHEET_ID=
GOOGLE_TEMPLATE_COMPSET_RANK_SHEET_ID=
GOOGLE_TEMPLATE_TITLE_META_SHEET_ID=
GOOGLE_TEMPLATE_HEADINGS_DOC_ID=
GOOGLE_TEMPLATE_IMAGE_OPT_SHEET_ID=
GOOGLE_TEMPLATE_TECH_AUDIT_SHEET_ID=
GOOGLE_TEMPLATE_SITEMAP_DOC_ID=
GOOGLE_TEMPLATE_DUPLICATE_CONTENT_SHEET_ID=
GOOGLE_TEMPLATE_SCHEMA_DOC_ID=
GOOGLE_TEMPLATE_TECH_REAUDIT_DOC_ID=
GOOGLE_TEMPLATE_OFFPAGE_KICKOFF_DOC_ID=
GOOGLE_TEMPLATE_OUTREACH_DOC_ID=
GOOGLE_TEMPLATE_BACKLINK_COMP_SHEET_ID=
GOOGLE_TEMPLATE_BACKLINK_STRATEGY_DOC_ID=
GOOGLE_TEMPLATE_LOCAL_CITATION_SHEET_ID=
GOOGLE_TEMPLATE_MONTHLY_VISIBILITY_PPTX_ID=
GOOGLE_TEMPLATE_QUARTERLY_AI_SEO_PPTX_ID=
GOOGLE_TEMPLATE_FINAL_REPORT_DOC_ID=

# ------------------------------------------------------------------------------
# Third-Party SEO APIs
# ------------------------------------------------------------------------------
# Semrush API (optional — direct keyword pull without manual CSV exports)
SEMRUSH_API_KEY=

# ------------------------------------------------------------------------------
# SEO Studio Platform Runtime (Phase 5.1)
# ------------------------------------------------------------------------------
# Credential vault key for stored CMS secrets. REQUIRED in production.
CMS_VAULT_KEY=
# Persistence adapter: jsonl (default, on-disk) | memory (ephemeral)
PLATFORM_STORAGE=jsonl
# Directory for the NDJSON adapter (defaults to .platform-data)
PLATFORM_DATA_DIR=

# ------------------------------------------------------------------------------
# Platform Auth & Data Integrity
# ------------------------------------------------------------------------------
# HMAC key for signed operator sessions (>= 32 chars). REQUIRED in production.
# Generate with: openssl rand -hex 32
PLATFORM_SESSION_SECRET=
# Local-only escape hatch: accept unsigned cw_actor_* cookies. Refused when
# NODE_ENV=production. Never enable on a public deployment.
PLATFORM_DEV_AUTH=0
# Gate synthetic/demo SEO data (GSC rows, keyword volumes, backlink profiles).
# Default off — engines return explicit empty results instead of invented data.
ALLOW_SIMULATED_DATA=0
# Site-wide page gate (off by default). When enabled, every page except
# /templates/*, robots, sitemap, llms.txt, llms-full.txt and static assets
# requires these basic-auth credentials. Both must be set or access is denied.
SITE_AUTH_ENABLED=0
SITE_BASIC_AUTH_USER=
SITE_BASIC_AUTH_PASSWORD=
# Shared rate limiting. With no credentials the in-memory per-instance limiter
# is used; with both set, Upstash/Vercel KV REST applies across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Operator token accepted by the shared API guard (in addition to the bearer
# token below and valid signed sessions).
PLATFORM_OPERATOR_TOKEN=
# Local-only bridges (host process execution). Keep disabled on deployments.
SEO_STUDIO_ALLOW_LOCAL_PYTHON=0
SEO_STUDIO_ALLOW_LOCAL_MAIL_CLI=0
SEO_STUDIO_MAIL_CLI_PATH=
SEO_STUDIO_MAIL_ACCOUNT=
PYTHON_BIN=python3

# ------------------------------------------------------------------------------
# SEO Validation & Quality Gate Thresholds
# ------------------------------------------------------------------------------
# SERP pixel-width ceilings (Google search standards)
SERP_DESKTOP_TITLE_WIDTH_MAX=580
SERP_MOBILE_TITLE_WIDTH_MAX=920
SERP_META_DESC_MIN_CHARS=70
SERP_META_DESC_MAX_CHARS=160
SERP_META_DESC_WIDTH_MAX=920

# Anti-Thin-Content & Uniqueness Gates
MIN_UNIQUE_WORD_COUNT=250
MAX_SIMILARITY_THRESHOLD=0.70

# Semantic Internal Linking Limits
INTERNAL_LINK_MAX_PER_PAGE=5
INTERNAL_LINK_MAX_PER_TARGET=1

# ------------------------------------------------------------------------------
# Chrome Extension Ingestion & Fine-Tuning Sync API
# ------------------------------------------------------------------------------
SEO_STUDIO_API_ENDPOINT=https://seo-studio.vercel.app/api/ai-training
SEO_STUDIO_API_BEARER_TOKEN=
