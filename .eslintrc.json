{
  "extends": [
    "next/core-web-vitals"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**/*.tsx",
        "src/components/data/**/*.tsx",
        "src/components/shell/**/*.tsx",
        "src/components/motion/**/*.tsx",
        "src/components/pages/**/*.tsx",
        "src/components/BrandMark.tsx",
        "src/components/SiteFooter.tsx",
        "src/components/TemplatesHubClient.tsx",
        "src/components/StrategyMatrixContent.tsx",
        "src/components/ArchitectureContent.tsx",
        "src/components/TemplateCustomizerView.tsx",
        "src/app/(public)/**/*.tsx",
        "src/app/(app)/**/*.tsx",
        "src/app/dev/**/*.tsx",
        "src/app/layout.tsx"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
            "message": "Raw hex colors are disallowed in design-system components. Use CSS variable tokens."
          },
          {
            "selector": "Literal[value=/\\b(slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-[0-9]{2,3}\\b/]",
            "message": "Non-token Tailwind palette classes are disallowed. Use semantic color tokens."
          },
          {
            "selector": "Literal[value=/\\bdark:/]",
            "message": "Manual dark: classes are disallowed. Dark mode resolves through CSS variables."
          },
          {
            "selector": "Literal[value=/\\brounded-(2xl|3xl)\\b/]",
            "message": "Use token radii (rounded-sm, rounded, rounded-lg, rounded-full) instead of rounded-2xl/3xl."
          }
        ]
      }
    }
  ]
}
