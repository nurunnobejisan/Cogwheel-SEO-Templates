# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert
credentials.json
service-account*.json
*.keystore

# ------------------------------------------------------------------------------
